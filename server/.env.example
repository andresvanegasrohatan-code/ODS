# ---------- Servidor ----------
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------- Seguridad ----------
# Cambia este valor por una cadena larga y aleatoria (ej: openssl rand -hex 48)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# ---------- Base de datos ----------
# sqlite (por defecto), mysql o postgres
DB_DIALECT=sqlite
SQLITE_PATH=./database.sqlite

# Solo si DB_DIALECT=mysql (crear antes el esquema en MySQL Workbench)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=equigenero
# DB_USER=equigenero_app
# DB_PASSWORD=
# Para MySQL remoto con TLS (por ejemplo Aiven), configura el CA proporcionado:
# DB_SSL=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\nPEGA_AQUI_EL_CERTIFICADO_CA\n-----END CERTIFICATE-----"

# Solo si DB_DIALECT=postgres
# DATABASE_URL=postgres://usuario:clave@localhost:5432/equigenero
# DB_SSL=false

# ---------- Administrador inicial (npm run seed) ----------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@equigenero.com
ADMIN_PASSWORD=Admin12345!

# ---------- Evidencias cifradas (Supabase Storage privado) ----------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCIAS_BUCKET=equigenero-evidencias

# En desarrollo se usa el proxy de Vite (/api -> http://localhost:4000).
# En producción, apunta a la URL pública de tu API, por ejemplo:
# VITE_API_URL=https://tu-api.onrender.com/api
VITE_API_URL=/api
# Necesarios solo para cargas directas a Supabase con tokens firmados:
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
# VITE_SUPABASE_EVIDENCIAS_BUCKET=equigenero-evidencias
